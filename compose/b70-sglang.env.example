# compose/b70-sglang.env — host paths and the trial's container environment.
# Copy this file to compose/b70-sglang.env (gitignored) and edit the host paths.
# harness/serve_compose.sh passes it to `docker compose --env-file`. A variable
# already exported wins over this file. Selecting compose/b70-sglang.yaml selects
# this env file (A770B_COMPOSE_ENV_FILE defaults to the yaml path with .env).
#
# The trial ran
# ghcr.io/0xsero/sglang-exl3-xpu-flashnext@sha256:24c872759256d4b0d3b9d0419ebdf6f3547e0fdbd3891fbb9f90e32ad255c94f.
# That image's certifi 2026.07.22 bundle and uv 0.12.16 still trust the compromised emSign
# ECC Root CA - G3 root. Build the refresh and then pin it by image id. A tag is a floating
# name; doctor warns until this line is a digest.
#   docker build -f compose/refresh-ca.Dockerfile \
#     --build-arg BASE=ghcr.io/0xsero/sglang-exl3-xpu-flashnext@sha256:24c872759256d4b0d3b9d0419ebdf6f3547e0fdbd3891fbb9f90e32ad255c94f \
#     -t a770-builder/sglang-flashnext-ca:2026-10-25 .
A770B_SGLANG_IMAGE=a770-builder/sglang-flashnext-ca:2026-10-25
# The builder card's two DRM nodes by PCI BDF. Find yours with:
#   ls -l /dev/dri/by-path/   and   lspci -nn | grep -i vga
A770B_DRM_CARD=/dev/dri/by-path/pci-0000:0b:00.0-card
A770B_DRM_RENDER=/dev/dri/by-path/pci-0000:0b:00.0-render
# Container targets. They must be what `readlink -f` of the two by-path nodes
# prints. Same-path bind, not a remap onto card0 or renderD128.
A770B_SGLANG_CARD_NODE=/dev/dri/card1
A770B_SGLANG_RENDER_NODE=/dev/dri/renderD129
# The host render and video group ids: `getent group render` and `getent group video`.
# 105 and 39 are this workstation's; the next host will differ.
A770B_RENDER_GID=105
A770B_VIDEO_GID=39
#
# Host side of each bind. Container targets are fixed in compose/b70-sglang.yaml.
# Leave these empty until this machine's paths are filled in. Do not put a home
# directory here in the example. serve sets the model dir and basename from the
# profile before compose up, and sets EXL3_MODEL_PATH to that in-container path.
A770B_SGLANG_MODEL_DIR=
A770B_SGLANG_MODEL_NAME=model
A770B_SGLANG_PACK=
A770B_SGLANG_PLUGIN=
A770B_SGLANG_NVTIER=
A770B_SGLANG_MOE_PY=
A770B_SGLANG_MOE_SO=
A770B_SGLANG_QSA_SO=
A770B_SGLANG_HC=
A770B_SGLANG_N107QSA=
A770B_SGLANG_QSA_BASE=
A770B_SGLANG_QSA_OVERLAY=
A770B_SGLANG_TCACHE=
#
# Container environment from the trial. HOME=/tmp is the container's home.
HOME=/tmp
HF_HUB_OFFLINE=1
ZE_AFFINITY_MASK=0
NEOReadDebugKeys=1
EnableSharedSystemUsmSupport=1
EnableRecoverablePageFaults=1
EXL3_MODEL_PATH=/models/model
EXL3_MOE_LIB=/n104/_moe_a8.so
EXL3_MOE_SLOTS=8000
EXL3_MOE_CACHE=1
EXL3_NVTIER_SVM_PREFETCH=1
EXL3_NVTIER_STAGE=1
EXL3_NVTIER_NO_VICTIM=0
EXL3_NVTIER_ASYNC=1
EXL3_HC_DIR=/hc
EXL3_HC_XPU=1
EXL3_HC_MIX=epilogue
EXL3_HC_COMBINE=torch
TRITON_CACHE_DIR=/tcache
EXL3_NVTIER_STAGE_PROF=0
EXL3_NVTIER_STAGE_HOSTBUF=5
EXL3_NVTIER_PREFILL_M=5
EXL3_NVTIER_PROF_EVERY=48
EXL3_NVTIER_FILL_THREADS=8
EXL3_NVTIER=1
EXL3_NVTIER_STORE=/xfs/qwen_experts.bin
# The measured host has about 64 GiB of RAM. The weights do not fit on the 32 GiB card.
EXL3_NVTIER_RAM_GB=20
EXL3_NVTIER_LAYERS=48
EXL3_NGRAM_TIER=nvme
SGLANG_EXL3_NGRAM_RAM_GB=1
SGLANG_EXL3_KV_BITS=5
EXL3_QSA_DENSE_BYTES=134217728
EXL3_QSA_ROWS=64
EXL3_TORCH_MEM_FRACTION=0.95
TORCHINDUCTOR_COMPILE_THREADS=1
EXL3_QSA_IMPL=sycl_row
EXL3_QSA_SELECT=sycl
EXL3_QSA_TRITON_CHECK=4
EXL3_QSA_SELECT_CHECK=4
EXL3_QSA_SYCL_LIB=/n104/qsa_row_sycl.so
