# Copy to compose/a770-vulkan.env (gitignored). Resolve DRM nodes from PCI BDF, not card0.
# On this workstation the A770 is pci-0000:0b:00.0; the next host will differ.
A770B_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:full-vulkan
A770B_DRM_CARD=/dev/dri/by-path/pci-0000:0b:00.0-card
A770B_DRM_RENDER=/dev/dri/by-path/pci-0000:0b:00.0-render
A770B_RENDER_GID=105
A770B_VIDEO_GID=39
A770B_MODELS=/home/YOU/LLM/tested
A770B_MODEL=Qwen3.5-9B-Q4_K_M.gguf
A770B_CTX=81920
A770B_PORT=8093
