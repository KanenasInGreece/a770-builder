# compose/a770-vulkan.env — the container envelope's host-specific values.
# Copy this file to compose/a770-vulkan.env (gitignored) and edit it. harness/serve_compose.sh passes it to
# `docker compose --env-file`; a variable already exported by harness/env.sh wins over this file, so set here only
# what env.sh does not know: the image and the two DRM nodes / host group ids for THIS machine.
#
# The image: full-vulkan, NOT server-vulkan. server-vulkan ships llama-server only; full-vulkan copies build/bin/*
# so the one-shot llama-bench job (the speed rung) is in the same image. Pin by digest after the first pull:
#   A770B_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:<digest>
A770B_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:full-vulkan
# The A770's two DRM nodes by PCI BDF (not card0/renderD128: those names drift when the desktop moves).
# Find yours with: ls -l /dev/dri/by-path/   and   lspci -nn | grep -i vga
A770B_DRM_CARD=/dev/dri/by-path/pci-0000:0b:00.0-card
A770B_DRM_RENDER=/dev/dri/by-path/pci-0000:0b:00.0-render
# The host render and video group ids: `getent group render` and `getent group video` on THIS host.
# 105 and 39 are this workstation's; the next host will differ.
A770B_RENDER_GID=105
A770B_VIDEO_GID=39
# The container's uid:gid defaults to this host's `id -u`/`id -g` (harness/env.sh), which owns A770B_API_KEY_FILE
# (mode 600) and so can read the read-only key mount. env.sh exports it, and the shell environment wins over this
# file, so to override it set A770B_CONTAINER_UID/GID in builder.env or the environment — NOT here.
#
# A770B_MODELS, A770B_PORT, A770B_VK_DEVICE_SELECT and A770B_API_KEY_FILE come from harness/env.sh (builder.env or
# the environment), so they are deliberately NOT set here — one source, not two.
