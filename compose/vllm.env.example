# compose/vllm.env — the vLLM container envelope's host-specific values.
# Copy this file to compose/vllm.env (gitignored) and edit it. harness/serve_compose.sh passes it to
# `docker compose --env-file`; a variable already exported by harness/env.sh wins over this file, so set here only
# what env.sh does not know: the image and the DRM nodes / host group ids for THIS machine.
#
# The image: intel/vllm:0.21.0-xpu. The Intel XPU vLLM serving container.
#
# Pin the exact bytes by digest, never the floating tag: upstream can move a tag at any time, so the same name can
# hand a different image to another host. Pull once, read the fingerprint, and paste it here. Replace the tag
# below with your own digest after your first pull:
#   docker pull intel/vllm:0.21.0-xpu
#   docker inspect --format='{{index .RepoDigests 0}}' intel/vllm:0.21.0-xpu
# The first pull legitimately starts from the tag; `local-build.sh doctor` warns until this line carries a digest.
# A digest is a name that cannot be silently swapped, not a secret — safe to commit.
A770B_VLLM_IMAGE=intel/vllm:0.21.0-xpu
# The builder card's two DRM nodes by PCI BDF (not card0/renderD128: those names drift when the desktop moves).
# Find yours with: ls -l /dev/dri/by-path/   and   lspci -nn | grep -i vga
A770B_DRM_CARD=/dev/dri/by-path/pci-0000:0b:00.0-card
A770B_DRM_RENDER=/dev/dri/by-path/pci-0000:0b:00.0-render
# TRAP: Do NOT point A770B_BY_PATH_DIR at /dev/dri/by-path!
# That exposes BOTH cards' symlinks and oneCCL's opendir then sees the neighbour card.
# Point it at a FILTERED directory carrying only the builder card's two symlinks
# (pci-<bdf>-card and pci-<bdf>-render pointing to ../cardN and ../renderD128),
# built once by hand (a filtered directory holding only the builder card's two ../cardN symlinks).
A770B_BY_PATH_DIR=
# The host render and video group ids: `getent group render` and `getent group video` on THIS host.
# 105 and 39 are this workstation's; the next host will differ.
A770B_RENDER_GID=105
A770B_VIDEO_GID=39
#
# A770B_MODELS, A770B_PORT, A770B_API_KEY_FILE, A770B_CONTAINER_UID and A770B_CONTAINER_GID come from
# harness/env.sh (builder.env or the environment), so they are deliberately NOT set here — one source, not two.
# To select THIS envelope, set A770B_COMPOSE_FILE=compose/vllm.yaml; the env file it reads is derived from it
# (A770B_COMPOSE_ENV_FILE defaults to the envelope path with .yaml -> .env), so selecting the vLLM yaml also
# selects this vLLM env file — you do not set both. Set A770B_COMPOSE_ENV_FILE only to point at a non-derived path.
