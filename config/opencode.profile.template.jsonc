{
  // opencode profile TEMPLATE for the local builder seat. build_local.sh renders it per run through
  // harness/render_profile.py into $A770B_DATA/logs/opencode.<profile>.jsonc (mode 600), replacing
  // __BASEURL__ __APIKEY__ __CTX__ __OUTPUT__ __NAME__ from env.sh, __PROMPT__ __EDIT_RULES__ __BASH_ALLOW__
  // from the run specification (their defaults: the prompt in render_profile.py, edit allowed everywhere, no extra
  // bash patterns), and __SAMPLING__ from the profile's sampling.temperature and sampling.top_p, when the registry
  // gives them (empty otherwise: the client sends its own default temperature otherwise, which is why the profile
  // carries one).
  // The key is the server's: the model inside the sandbox can read it, and can reach nothing but that server with it.
  // It is the ONLY opencode config inside the sandbox (the global config never enters), so the policy below is
  // the whole policy: bash is DEFAULT-DENY with an explicit allow-list; edits stay inside the project (the sandbox
  // enforces that anyway); no MCP, no skills, no web. The deny block at the end of "bash" is the FLOOR: it is
  // rendered after every allow, so a pattern a run specification adds never outranks it. It is defence in depth:
  // the boundary itself is bubblewrap, the unshared network and the read-only .git.
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-a770": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local builder (__NAME__)",
      "options": { "baseURL": "__BASEURL__", "apiKey": "__APIKEY__" },
      "models": { "local-builder": { "name": "local-builder (__NAME__)", "limit": { "context": __CTX__, "output": __OUTPUT__ } } }
    }
  },
  "mcp": {},
  "permission": {
    "skill": { "*": "deny" },
    "webfetch": "deny",
    "doom_loop": "allow",
    "edit": { __EDIT_RULES__ },
    "read": { "*": "allow", "**/.env": "deny", "**/.env.*": "deny", "**/.envrc": "deny", "**/*.pem": "deny", "**/*.key": "deny", "**/id_*": "deny" },
    "bash": {
      "*": "deny",
      "ls *": "allow", "ls": "allow", "pwd": "allow", "cat *": "allow", "head *": "allow", "tail *": "allow", "wc *": "allow",
      "grep *": "allow", "rg *": "allow", "find *": "allow", "tree *": "allow", "diff *": "allow", "stat *": "allow", "file *": "allow",
      "echo *": "allow", "printf *": "allow", "true": "allow", "sed -n *": "allow", "awk *": "allow", "sort *": "allow", "uniq *": "allow",
      "mkdir *": "allow", "touch *": "allow", "cp *": "allow", "mv *": "allow",
      "python3 *": "allow", "python *": "allow", "pytest *": "allow", "python3 -m pytest *": "allow", "bash tests/*": "allow", "bash ./tests/*": "allow",
      "uv run *": "allow",
      "git status*": "allow", "git diff*": "allow", "git log*": "allow", "git show*": "allow", "git ls-files*": "allow", "git grep*": "allow", "git blame*": "allow",
      __BASH_ALLOW__"git commit*": "deny", "git push*": "deny", "git reset*": "deny", "git checkout*": "deny", "git switch*": "deny",
      "git merge*": "deny", "git rebase*": "deny", "git stash*": "deny", "git clean*": "deny", "git branch*": "deny", "git tag*": "deny",
      "git remote*": "deny", "git config*": "deny", "git worktree*": "deny", "git -c*": "deny", "git -C*": "deny", "git --git-dir*": "deny",
      "docker*": "deny", "podman*": "deny", "systemctl*": "deny", "sudo*": "deny", "su *": "deny",
      "uv pip *": "deny", "uv tool *": "deny", "pip *": "deny", "curl*": "deny", "wget*": "deny", "ssh*": "deny", "scp*": "deny", "nc *": "deny"
    }
  },
  "agent": {
    "local-builder": {
      "description": "Lean coding agent for the local builder seat",
      "mode": "primary",
      __SAMPLING__
      "prompt": "__PROMPT__",
      "tools": { "webfetch": false, "todowrite": false, "todoread": false, "task": false, "skill": false }
    }
  },
  "model": "local-a770/local-builder",
  "small_model": "local-a770/local-builder"
}
