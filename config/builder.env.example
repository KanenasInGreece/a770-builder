# builder.env — every path and knob of the A770 builder seat. Copy to ONE of:
#   <project>/config/builder.env                            (per project checkout; gitignored)
#   ${XDG_CONFIG_HOME:-~/.config}/a770-builder/builder.env   (per user; wins over the project file)
# A second, per-mode file loads after both of the above, before the calling environment:
#   <project>/config/builder.<mode>.env                            (gitignored, like builder.env)
#   ${XDG_CONFIG_HOME:-~/.config}/a770-builder/builder.<mode>.env  (per user; wins over the project's)
# where <mode> is A770B_CARD_MODE as it stands after the two plain builder.env files and the environment are read
# (so a per-mode file cannot switch the mode that selected it); it lets one machine keep different overrides for
# display mode and inference mode. Unset lines keep the defaults shown, which are the workstation the seat was
# qualified on. The file is sourced by bash: QUOTE values that contain spaces (e.g. A770B_FRAMEWORK_PORTS="8070 8888").

# The card mode
#A770B_CARD_MODE=display                    # display: config/profiles.json, for a card that also draws the desktop.
                                             #   inference: config/profiles.inference.json, for a card that draws
                                             #   nothing else. The VRAM cap is per card and has NO default — see
                                             #   A770B_VRAM_CAP_GIB below.

# Where things are
#A770B_DATA=$HOME/local-ai                  # results/, logs/, seat/, seat-cache/
#A770B_SEAT=$A770B_DATA/seat                # the worktree the model builds in: a plain clone of your target repo
#A770B_MODELS=$HOME/LLM/tested              # GGUF directory. The server reads models from here; the sandbox never sees it.
#A770B_HIDDEN_ROOT=$A770B_DATA/hidden       # hidden acceptance tests a run specification may name; verify copies them into the seat after the patch applies
A770B_REFUSE=/path/to/your/live/checkout   # REQUIRED — colon-separated trees the seat must refuse (your live repo checkouts); the guard refuses to run while empty

# Profiles (file names are relative to A770B_MODELS, or absolute)
#A770B_GEMMA4_8B_E4B_Q4KM_VULKAN_MODEL=gemma-4-E4B-it-Q4_K_M.gguf   # the fast profile: the reader, the largest window at speed; flash attention OFF is its condition on this card
#A770B_GEMMA4_8B_E4B_Q4KM_VULKAN_CTX=131072
#A770B_GEMMA4_8B_E4B_Q4KM_VULKAN_KV=f16                             # without flash attention the V cache cannot be quantised
#A770B_GEMMA4_8B_E4B_Q4KM_VULKAN_REASONING=off
#A770B_GEMMA4_8B_E4B_Q4KM_VULKAN_EXTRA='-fa off'
# The four SERIOUS lines below are this workstation's own override, measured on a card that also draws the desktop:
# belongs in builder.display.env, not the plain builder.env, since inference mode has 15.3 GiB to spend and no need
# of it.
#A770B_QWEN38_27B_IQ3XXS_VULKAN_MODEL=Qwen3.8-27B-GSQ-RCO-IQ3_S.gguf   # the quantiser's task-lossless file; 13.78 GiB at 114,688, needs a 14.1 cap
#A770B_QWEN38_27B_IQ3XXS_VULKAN_CTX=114688
#A770B_QWEN38_27B_IQ3XXS_VULKAN_KV=q4_0
#A770B_QWEN38_27B_IQ3XXS_VULKAN_REASONING=on
#A770B_QWEN38_27B_IQ3XXS_VULKAN_EXTRA='--chat-template-kwargs {"reasoning_effort":"low"} --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0'
#A770B_QWEN35_9B_Q4KM_VULKAN_MODEL=Qwen3.5-9B-Q4_K_M.gguf
#A770B_QWEN35_9B_Q4KM_VULKAN_CTX=81920
#A770B_QWEN35_9B_Q4KM_VULKAN_KV=q8_0                         # q4_0 fits 131072 on the same 16 GB card with no task loss
#A770B_QWEN35_9B_Q4KM_VULKAN_REASONING=off
#A770B_QWEN35_9B_Q4KM_VULKAN_TIMEOUT=1500
#A770B_GEMMA4_8B_E4B_Q4KM_VULKAN_TIMEOUT=1500
#A770B_QWEN38_27B_IQ3XXS_VULKAN_TIMEOUT=3600

# Thinking (a profile's `thinking` object in the registry, harness/profiles.py; overrides one profile's row —
# name the profile the way every other A770B_<PROFILE>_* line above does, e.g. A770B_QWEN38_27B_IQ3XXS_VULKAN_THINKING_MODE). Every
# knob is optional and empty means "let the registry row, or the server's own default, decide":
#A770B_QWEN38_27B_IQ3XXS_VULKAN_THINKING_MODE=on              # --reasoning on|off|auto: whether the model thinks before it answers
#A770B_QWEN38_27B_IQ3XXS_VULKAN_THINKING_EFFORT=low           # --reasoning-effort low|medium|high|xhigh|default: how much it thinks; a first-class flag, replacing the older --chat-template-kwargs '{"reasoning_effort":"..."}' trick
#A770B_QWEN38_27B_IQ3XXS_VULKAN_THINKING_BUDGET=512           # --reasoning-budget N: a hard token ceiling on thinking (-1 unrestricted, 0 cuts it off immediately)
#A770B_QWEN38_27B_IQ3XXS_VULKAN_THINKING_BUDGET_MESSAGE='budget spent, answer now'   # --reasoning-budget-message: injected before the end-of-thinking tag when the budget above is hit
#A770B_QWEN38_27B_IQ3XXS_VULKAN_THINKING_PRESERVE=true        # --reasoning-preserve (true, the server's own default) or --no-reasoning-preserve (false): keep the thinking trace in the whole history, or drop it after each turn

# The server
#A770B_LLAMA_BIN=                          # unused: the server runs in a container (harness/serve_compose.sh); kept only as a path variable
#A770B_DEVICE=Vulkan0                       # run `llama-server --list-devices`; the selector below pins exactly one card, so its index is 0
#A770B_VK_DEVICE_SELECT=8086:e223!          # REQUIRED, no default: vendor:device of the builder card with '!' (lspci -nn)
                                             #   — pins the server to it whatever card boots first. The Arc Pro B70 is
                                             #   8086:e223; the A770 was 8086:56a0.
#A770B_GPU_MATCH=G31                        # REQUIRED, no default: substring of the builder card's name in `nvtop -s`,
                                             #   used for VRAM readings and the cap. 'G31' (or 'Arc Pro B70') names the
                                             #   B70; the A770 was 'DG2'.
#A770B_RESET_PATTERN='engine reset|timedout' # SET THIS ON A NON-INTEL CARD: kernel-log regex (grep -ciE) every reset
                                             #   watch (ctx_sweep.sh, bench_model.sh, guard.sh's kernel_resets_since)
                                             #   greps for a GPU reset. The default shown is Intel's Xe driver wording;
                                             #   it will not match another driver's log lines and the watch will
                                             #   silently see zero resets. Find your own wording with
                                             #   `journalctl -k | grep -iE 'reset|timedout|hang'` right after a
                                             #   reproduced hang (amdgpu: "GPU reset", nvidia: "Xid"), and set this to it.
#A770B_PORT=7890
#A770B_UBATCH=512                           # keeps GPU jobs under the Xe 5 s watchdog; stays 512 in both modes
#A770B_VRAM_CAP_GIB=                       # REQUIRED, no default: the VRAM cap for the builder card in this mode. It is a
                                             #   per-card MEASUREMENT (absolute GiB on the card, not a fraction). Measure it
                                             #   before setting it: `nvtop -s`, sum every process on the card that is not the
                                             #   server, and leave headroom. Raise it only after a fresh measurement. The
                                             #   A770's caps were 13.0 (display) / 15.3 (inference); the B70's are its own.
#A770B_API_KEY_FILE=~/.config/a770-builder/api.key   # the server's API key: one line, mode 600, created on the first serve; delete it to rotate

# How the server is placed: container only
#A770B_SERVE=compose                        # the only value: the server runs in a container (harness/serve_compose.sh);
                                             #   the profile argv still comes from this registry, the envelope is
                                             #   compose/a770-vulkan.yaml, and the VRAM cap and sidecar stay on the host.
                                             #   The host llama-server path was removed.

# Present a card by preference: set A770B_<PROFILE>_OPERATOR_OVERRIDE=true here (or the card's operator_override in
# the registry). The menu reports it, and `serve` says so when it starts that card, so an override is never a
# surprise. Unset it to choose from all cards. For example:
#A770B_QWEN38_27B_IQ3S_SYCL_OPERATOR_OVERRIDE=true
#A770B_COMPOSE_FILE=$A770B_PROJECT/compose/a770-vulkan.yaml    # the envelope: devices, groups, mounts, port, entrypoint
#A770B_COMPOSE_ENV_FILE=$A770B_PROJECT/compose/a770-vulkan.env # gitignored: image, PCI nodes, host group ids (getent)
#A770B_COMPOSE_PROJECT=a770-builder          # the compose project name (its own container namespace)
#A770B_DOCKER=docker                         # the container runtime CLI (podman compose is untested)

# Budget gate (built in). Point A770B_BUDGET_GATE at your own script to replace it.
#A770B_BUDGET_GATE=
#A770B_MIN_AVAIL_MB=20000                   # host RAM that must stay available after a spawn
#A770B_MIN_VRAM_MB=3000                     # free VRAM on the builder card before a spawn
#A770B_FRAMEWORK_PORTS="8070 8888"          # ports the seat must never bind (another service's); default none
#A770B_HEALTH_URL=                          # e.g. http://localhost:8000/health — read once before a server starts; its status word is printed, never a refusal

# opencode + sandbox
#A770B_OPENCODE_BIN=                        # directory holding the opencode binary; empty = found on PATH
#A770B_UV_CACHE=$A770B_DATA/seat-cache/uv   # read-only inside the sandbox; fill it with harness/warm_cache.sh
#A770B_ALLOW_NO_NVTOP=0                     # 1 = start without VRAM readings (only on a card that draws no desktop)
#A770B_OUTPUT_TOKENS=16384                  # opencode per-reply output limit; a whole file goes out in one tool call, keep it generous

# Qualification (harness/run_one.sh) — write your own brief for your repo
#A770B_TASK_BRIEF=$A770B_PROJECT/briefs/T1-sanitize-entity-tests.md
#A770B_PROBE_CORPUS=$A770B_SEAT/**/*.py      # glob (recursive) of source files for the long-context prefill probe
